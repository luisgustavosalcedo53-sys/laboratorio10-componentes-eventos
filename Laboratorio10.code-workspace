{
  "folders": [
    {
      "path": ".",
      "name": "Laboratorio 10 · Componentes y eventos"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.venv": true,
      "**/build": true,
      "**/dist": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "1. Iniciar API Django (8000)",
        "type": "process",
        "command": "${workspaceFolder}/01-procedimiento/backend/.venv/Scripts/python.exe",
        "args": [
          "manage.py",
          "runserver",
          "127.0.0.1:8000"
        ],
        "options": {
          "cwd": "${workspaceFolder}/01-procedimiento/backend"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        }
      },
      {
        "label": "2. Iniciar procedimiento React (3000)",
        "type": "process",
        "command": "node",
        "args": [
          "node_modules/react-scripts/bin/react-scripts.js",
          "start"
        ],
        "options": {
          "cwd": "${workspaceFolder}/01-procedimiento/lab10"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        }
      },
      {
        "label": "3. Iniciar tarea Vite (5173)",
        "type": "process",
        "command": "node",
        "args": [
          "node_modules/vite/bin/vite.js",
          "--host",
          "127.0.0.1",
          "--port",
          "5173",
          "--strictPort"
        ],
        "options": {
          "cwd": "${workspaceFolder}/02-tarea"
        },
        "problemMatcher": [],
        "presentation": {
          "panel": "dedicated"
        }
      },
      {
        "label": "4. Probar API Django",
        "type": "process",
        "command": "${workspaceFolder}/01-procedimiento/backend/.venv/Scripts/python.exe",
        "args": [
          "manage.py",
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder}/01-procedimiento/backend"
        },
        "problemMatcher": []
      },
      {
        "label": "5. Probar tarea en navegador",
        "type": "process",
        "command": "node",
        "args": [
          "node_modules/@playwright/test/cli.js",
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder}/02-tarea"
        },
        "problemMatcher": []
      }
    ]
  }
}
